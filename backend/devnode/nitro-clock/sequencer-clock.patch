diff --git a/execution/gethexec/devclock.go b/execution/gethexec/devclock.go
new file mode 100644
index 0000000..f6245a2
--- /dev/null
+++ b/execution/gethexec/devclock.go
@@ -0,0 +1,42 @@
+// DEV ONLY (Crashline dev clock patch, not part of upstream Nitro).
+//
+// Lets a local --dev node stamp blocks in the future so time-based contracts
+// (weekly observations, maturities) can be exercised in a test run. The
+// sequencer adds the offset (int64 seconds, >= 0) read from the file named by
+// $SP_CLOCK_OFFSET_FILE to time.Now() for every block it creates. Unset env,
+// a missing file, a parse error or a negative value all mean offset 0, i.e.
+// stock Nitro behaviour. Never run this build on a public chain.
+
+package gethexec
+
+import (
+	"os"
+	"strconv"
+	"strings"
+	"sync/atomic"
+
+	"github.com/ethereum/go-ethereum/log"
+)
+
+var (
+	devClockOffsetFile = os.Getenv("SP_CLOCK_OFFSET_FILE")
+	devClockLastOffset atomic.Int64
+)
+
+// devClockOffset returns the DEV ONLY block timestamp offset in seconds. It
+// re-reads the (tiny) file on every call; createBlock calls it once per block.
+func devClockOffset() int64 {
+	if devClockOffsetFile == "" {
+		return 0
+	}
+	var offset int64
+	if raw, err := os.ReadFile(devClockOffsetFile); err == nil {
+		if v, err := strconv.ParseInt(strings.TrimSpace(string(raw)), 10, 64); err == nil && v > 0 {
+			offset = v
+		}
+	}
+	if prev := devClockLastOffset.Swap(offset); prev != offset {
+		log.Warn("DEV ONLY: block timestamp offset changed", "file", devClockOffsetFile, "offsetSeconds", offset, "previous", prev)
+	}
+	return offset
+}
