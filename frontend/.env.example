# Copy to .env.local (git-ignored). Every value ends up in the browser bundle.
# WalletConnect (Reown) project ID from https://cloud.reown.com; empty = browser wallets only.
VITE_WALLETCONNECT_PROJECT_ID=
# Which chain: empty = Robinhood Chain testnet (46630); 412346 = the Nitro dev node (docs/backend.md).
VITE_CHAIN_ID=
# RPC: empty = the chain's own (testnet: the public, rate-limited one; dev node: http://localhost:8647).
VITE_RPC_URL=
# The read service (docs/backend.md): contract addresses come from its /config, never from constants.
# Empty = no backend: testnet then reads deployments/46630.json, and without that file the app
# shows example data. Dev node through the SSH tunnel: http://localhost:8650
VITE_API_URL=
